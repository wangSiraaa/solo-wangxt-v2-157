# HTTP bind address
BIND=0.0.0.0:8080

# PostgreSQL connection
DATABASE_URL=postgres://sandbox:sandbox@127.0.0.1:5432/sandbox
DB_MAX_CONNECTIONS=10

# Hard resource ceilings (tenants may only request LESS via their contract)
SANDBOX_MAX_MEMORY_MIB=16
SANDBOX_MAX_FUEL=10000000
SANDBOX_MAX_OUTPUT_KB=64
SANDBOX_TIMEOUT_MS=10000

# Host-wide admission control: maximum simultaneously executing guest tasks
MAX_CONCURRENT_EXECS=64

# Max HTTP request body bytes (module uploads)
MAX_BODY_BYTES=9437184

# Logging
RUST_LOG=info,wasm_plugin_sandbox=debug,sqlx=warn
